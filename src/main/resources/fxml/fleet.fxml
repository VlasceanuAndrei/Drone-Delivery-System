<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="600.0" minWidth="1024.0" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="andreiv.ui.FleetViewController">
   <left>
      <VBox minWidth="200.0" prefWidth="220.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <VBox>
               <children>
                  <Label styleClass="brand-title" text="Drone Delivery System" />
                  <Label styleClass="brand-subtitle" text="You send, we deliver" />
               </children>
            </VBox>
            <Button fx:id="navHubs" mnemonicParsing="false" onAction="#goHubs" text="Hubs" />
            <Button fx:id="navFleet" mnemonicParsing="false" onAction="#goFleet" styleClass="nav-active" text="Fleet" />
            <Button fx:id="navOrders" mnemonicParsing="false" onAction="#goOrders" text="Orders" />
         </children>
      </VBox>
   </left>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <HBox styleClass="page-header">
               <children>
                  <Label styleClass="page-title" text="Fleet Overview" />
               </children>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Add drone to hub" />
                  <Label styleClass="field-label" text="SELECT HUB" />
                  <ComboBox fx:id="hubSelectorCombo" maxWidth="Infinity" promptText="Select a hub..." styleClass="hub-selector" />
                  <Label styleClass="field-label" text="DRONE NAME" />
                  <TextField fx:id="droneNameField" maxWidth="Infinity" promptText="Drone name..." />
                  <Label styleClass="field-label" text="TYPE" />
                  <ComboBox fx:id="droneTypeCombo" maxWidth="Infinity" styleClass="hub-selector" />
                  <Label styleClass="field-label" text="FLIGHT RANGE (KM)" />
                  <TextField fx:id="flightRangeField" maxWidth="Infinity" promptText="0...550" />
                  <Label styleClass="field-label" text="MAX PAYLOAD (KG)" />
                  <TextField fx:id="maxPayloadField" maxWidth="Infinity" promptText="Maximum payload..." />
                  <Label styleClass="field-label" text="MAX SPEED (KM/H)" />
                  <TextField fx:id="maxSpeedField" maxWidth="Infinity" promptText="Maximum speed..." />
                  <CheckBox fx:id="availableCheck" mnemonicParsing="false" selected="true" text="Drone is available" />
                  <CheckBox fx:id="refrigeratedCheck" managed="false" mnemonicParsing="false" text="Can carry refrigerated packages" visible="false" />
                  <HBox>
                     <children>
                        <Button mnemonicParsing="false" onAction="#onClear" styleClass="button-secondary" text="Clear" />
                        <Button mnemonicParsing="false" onAction="#onAddDrone" styleClass="button-primary" text="Add drone" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>
